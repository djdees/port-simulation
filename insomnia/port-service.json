      "parentId": "wrk_port_service",
      "name": "GET /berths",
      "method": "GET",
      "url": "{{ _.base_url }}{{ _.api_prefix }}/berths",
      "parameters": [
        {"name": "terminal_id", "value": "TRM-001", "disabled": true}
      ]
    },
    {
      "_id": "req_vessel_not_found",
      "_type": "request",
      "parentId": "wrk_port_service",
      "name": "GET /vessels/:id — Not Found",
      "method": "GET",
      "url": "{{ _.base_url }}{{ _.api_prefix }}/vessels/VSL-999"
    },
    {
      "_id": "req_bad_kind_filter",
      "_type": "request",
      "parentId": "wrk_port_service",
      "name": "GET /vessels — Invalid kind (400)",
      "method": "GET",
      "url": "{{ _.base_url }}{{ _.api_prefix }}/vessels",
      "parameters": [
        {"name": "kind", "value": "zeppelin"}
      ]
    }
  ]
}
